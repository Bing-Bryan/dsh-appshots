{
  "name": "dsh-appshots",
  "version": "0.4.2",
  "description": "Codex-style Appshots for the official DeepSeek Harness desktop (and DSH Desktop): double-tap Right Command (or Space + Right Command / Right Command + Right Option, or the camera button) grabs the frontmost window and attaches its screenshot to the composer draft, with the accessibility tree available through View text.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "native",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "WongYuYe",
  "contributors": [
    "Bing-Bryan"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bing-Bryan/dsh-appshots.git"
  },
  "bugs": {
    "url": "https://github.com/Bing-Bryan/dsh-appshots/issues"
  },
  "homepage": "https://github.com/Bing-Bryan/dsh-appshots#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "appshots",
    "screenshot",
    "macos",
    "windows"
  ],
  "os": [
    "darwin",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:native": "mkdir -p bin && swiftc -O native/AppshotCapture.swift -o bin/appshot-capture"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1 <1.0.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
